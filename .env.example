# ==============================================================================
# KISHOR KUMAR PORTFOLIO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and set your real credentials.
# NEVER commit your real '.env' file containing real secrets to public git repositories.

# Server Port
PORT=3000
NODE_ENV=development

# Authorized Administrator Credentials
# Only requests from this admin identity will have access to the admin dashboard.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Session & JWT Security Secret
# Generate a random 64-character string for production use
AUTH_SECRET=your-very-long-and-secure-random-auth-secret-key-here

# Persistent Storage Path (Optional: defaults to ./uploads)
UPLOADS_DIR=./uploads

# Optional: Google Drive & Picker API Configuration
# Used by the Resume Manager if you want to import resumes directly from your Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
